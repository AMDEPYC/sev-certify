#!/bin/bash
set -euo pipefail
set -x

# SNPHOST_TAG is resolved by one of:
# - CI: resolve-tags job resolves SNPHOST_TAG (pinned in versions.env or latest release)
#   and passes it via mkosi.conf injection: Environment=SNPHOST_TAG=<tag>
# - Local: images Makefile resolves SNPHOST_TAG and passes it via .tags env-file
: "${SNPHOST_TAG:?SNPHOST_TAG is not set; build through the images Makefile or CI workflow}"

# Download and install into DESTDIR with correct permissions
curl -fsSL "https://github.com/virtee/snphost/releases/download/${SNPHOST_TAG}/snphost" \
  | install -D -m 0755 /dev/stdin "${DESTDIR}/usr/local/bin/snphost"
