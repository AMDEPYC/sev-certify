# Upstream release versions used to build the host/guest images and dispatch tool.
# Bump deliberately via a PR so any breakage in a new release is caught at review time.
# Leave a value empty to fall back to the upstream latest release at build time.
#
# Naming convention: <COMPONENT>_TAG=<release tag>, where <COMPONENT> is the upper-cased
# component name, e.g. snpguest -> SNPGUEST_TAG=v0.10.0. The component name must match:
#   - for components built into the images, its module directory,
#     modules/build/{common,host}/<component>/, whose mkosi.build reads <COMPONENT>_TAG
#   - for dispatch, it is used by the Makefile to validate compatibility with the images
# The value is the upstream GitHub release tag exactly as published (including any "v" prefix).
# Only the names below are accepted; any other line fails the versions check in CI and make.
SNPHOST_TAG=v0.9.0
# snpguest held at v0.10.0: v0.11.0 (virtee/snpguest#145) changed generate id-block
# --family-id/--image-id from 16-char ASCII to 32-char hex. sev_verify/cvm_props.py passes
# ASCII defaults and compares report bytes as ASCII, so ID-block generation (id_block_test,
# key_derivation_test) currently fails on v0.11.0. Bump once cvm_props.py is updated for hex IDs.
SNPGUEST_TAG=v0.10.0
BEACON_TAG=v1.1.0
# dispatch (AMDEPYC/dispatch) is not built into the images: it runs on the Dispatch Host,
# serves the host images over HTTP boot and receives results from beacon inside them.
# Keep it compatible with BEACON_TAG. Used in docs/how-to-generate-certs.md for binary download.
DISPATCH_TAG=v0.1.1

